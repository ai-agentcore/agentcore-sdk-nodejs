{
  "name": "alibabacloud-agentcore-sdk",
  "version": "0.1.0",
  "description": "AgentCore runtime SDK for Node.js",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "collaboration": ["dist/collaboration/index.d.ts"],
      "auth": [
        "dist/auth/index.d.ts"
      ],
      "controlplane": [
        "dist/controlplane/index.d.ts"
      ],
      "model": [
        "dist/model/index.d.ts"
      ],
      "mcp": [
        "dist/mcp/index.d.ts"
      ],
      "skill": [
        "dist/skill/index.d.ts"
      ],
      "memory": [
        "dist/memory/index.d.ts"
      ],
      "runtime": [
        "dist/runtime/index.d.ts"
      ],
      "server": [
        "dist/server/index.d.ts"
      ],
      "integrations/*": [
        "dist/integrations/*.d.ts"
      ]
    }
  },
  "exports": {
    "./collaboration": {
      "import": { "types": "./dist/collaboration/index.d.ts", "default": "./dist/collaboration/index.js" },
      "require": { "types": "./dist/collaboration/index.d.cts", "default": "./dist/collaboration/index.cjs" }
    },
    "./integrations/mastra": {
      "import": { "types": "./dist/integrations/mastra.d.ts", "default": "./dist/integrations/mastra.js" },
      "require": { "types": "./dist/integrations/mastra.d.cts", "default": "./dist/integrations/mastra.cjs" }
    },
    "./integrations/google-adk": {
      "import": {
        "types": "./dist/integrations/google-adk.d.ts",
        "default": "./dist/integrations/google-adk.js"
      },
      "require": {
        "types": "./dist/integrations/google-adk.d.cts",
        "default": "./dist/integrations/google-adk.cjs"
      }
    },
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./auth": {
      "import": {
        "types": "./dist/auth/index.d.ts",
