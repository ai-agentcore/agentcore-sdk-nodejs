        "types": "./dist/skill/index.d.cts",
        "default": "./dist/skill/index.cjs"
      }
    },
    "./memory": {
      "import": {
        "types": "./dist/memory/index.d.ts",
        "default": "./dist/memory/index.js"
      },
      "require": {
        "types": "./dist/memory/index.d.cts",
        "default": "./dist/memory/index.cjs"
      }
    },
    "./integrations/langgraph": {
      "import": {
        "types": "./dist/integrations/langgraph.d.ts",
        "default": "./dist/integrations/langgraph.js"
      },
      "require": {
        "types": "./dist/integrations/langgraph.d.cts",
        "default": "./dist/integrations/langgraph.cjs"
      }
    },
    "./integrations/langchain": {
      "import": {
        "types": "./dist/integrations/langchain.d.ts",
        "default": "./dist/integrations/langchain.js"
      },
      "require": {
        "types": "./dist/integrations/langchain.d.cts",
        "default": "./dist/integrations/langchain.cjs"
      }
    },
    "./integrations/ai-sdk": {
      "import": {
        "types": "./dist/integrations/ai-sdk.d.ts",
        "default": "./dist/integrations/ai-sdk.js"
      },
      "require": {
        "types": "./dist/integrations/ai-sdk.d.cts",
        "default": "./dist/integrations/ai-sdk.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.ts",
        "default": "./dist/server/index.js"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./runtime": {
      "import": {
        "types": "./dist/runtime/index.d.ts",
        "default": "./dist/runtime/index.js"
      },
      "require": {
        "types": "./dist/runtime/index.d.cts",
        "default": "./dist/runtime/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "npm run build && node --test tests/package.test.cjs",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.59",
    "@alicloud/agentcore20260804": "1.2.1",
    "@alicloud/agentidentitydata20251127": "^2.0.0",
    "@alicloud/openapi-core": "^1.0.8",
    "@anthropic-ai/sdk": "^0.124.0",
    "@darabonba/typescript": "^1.0.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "hono": "^4.13.7",
    "openai": "^6.15.0",
    "yaml": "^2.8.1",
    "yauzl": "^3.4.0"
  },
