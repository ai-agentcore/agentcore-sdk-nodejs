{
  "name": "alibabacloud-agentcore-collaboration",
  "version": "0.1.1",
  "description": "Independently versioned AgentCore Worker collaboration",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-agentcore/agentcore-sdk-nodejs.git",
    "directory": "packages/collaboration"
  },
  "type": "module",
  "engines": { "node": ">=20.3.0" },
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": {
    "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
  } },
  "files": ["dist", "worker-skills", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:package": "npm run build && node --test tests/package.test.cjs",
    "test:frameworks": "npm --prefix ../.. run build && npm run build && node --test tests/framework-package.test.cjs",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": { "yaml": "^2.8.1", "mime-types": "^3.0.1" },
  "peerDependencies": { "alibabacloud-agentcore-sdk": "^0.1.0" },
  "devDependencies": {
    "alibabacloud-agentcore-sdk": "file:../..",
    "@types/node": "^20.19.0",
    "@types/mime-types": "^3.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
